    "intro": "I'm a first-year Nanotechnology Engineering student at Waterloo. I like understanding how things work, then making something of my own. I'm looking for a Spring 2027 co-op.",
    "about": "My interests sit somewhere between hardware and software: nanotechnology, semiconductors, and native apps. Right now, I'm learning the engineering fundamentals and building things I actually want to use.",
    "personalIntro": "Big open worlds. Stories that stay with me. Games that test my patience. Here's what I reach for when the work is done."
  },
  "projects": [
    {
      "id": "somodoro",
      "name": "Somodoro",
      "category": "Native iOS app",
      "status": "Personal project",
      "summary": "A focus timer made for the way I study. Native on iPhone and iPad, with study logs, widgets, and data that stays on the device.",
      "tags": [
        "Swift",
        "SwiftUI",
        "WidgetKit"
      ],
      "visual": "timer",
      "details": [
        "Custom study and break periods, with pause and resume across app launches.",
        "Study history, session ratings, and statistics across day, week, month, and year.",
        "Home Screen and Lock Screen widgets, with shared data when supported by the signing configuration.",
        "On-device JSON storage and export. No account or server required."
      ],
      "note": "Personal native app project. Repository is private; happy to discuss the implementation."
    },
    {
      "id": "teng",
      "name": "Wind to electricity",
      "category": "TENG design study",
      "status": "In progress",
      "summary": "A modular, 3D-printable wind collector for a triboelectric nanogenerator. Designing for air from any direction, printable parts, and a compatible shaft connection.",
      "tags": [
        "SolidWorks",
        "3D printing",
        "Engineering design"
      ],
      "visual": "rotor",
      "details": [
        "Designing the top fan assembly and its interface with the device's rod.",
        "Exploring a cup-style rotor to collect wind from different horizontal directions.",
        "Splitting the assembly into printable parts and considering fit and retention.",
        "Current work is a design and fabrication study; performance has not yet been established."
      ],
      "note": "Current Waterloo design work. The preview is a concept illustration, not a dimensioned drawing or tested prototype."
    },
    {
      "id": "sign",
      "name": "Somil Sign Pro",
      "category": "iOS interface experiment",
      "status": "Modified open-source build",
      "summary": "A Windows 95-inspired take on an iOS signing app. Reworking the interface while building on Feather's existing signing foundation.",
      "tags": [
        "Swift",
        "iOS",
        "Interface design"
      ],
      "visual": "retro",
      "details": [
        "A retro desktop visual direction applied to an on-device iOS signing application.",
        "Based on Feather 2.8.2, retaining the upstream signing engine and app-management features.",
        "Work includes adapting the interface and preparing build and packaging workflows.",
        "Upstream GPL-3.0 licensing and dependency credits are preserved. Device runtime remains unverified."
      ],
      "note": "Modified Feather build, with credit to Feather and its dependencies. Private repository; not an official KravaSign product."
    }
  ],
